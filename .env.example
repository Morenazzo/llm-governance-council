# OpenRouter API Key
# Get your API key from https://openrouter.ai/
# This is the ONLY API key needed - all models use OpenRouter as gateway
OPENROUTER_API_KEY=your_api_key_here

# Delphi Mode (optional)
# Enable iterative reflection rounds where models can revise after peer feedback
# Set to "true" to enable, "false" or omit to disable (default: false)
DELPHI_MODE=false

# ---------------------------------------------------------------------------
# Council roster (all optional - each seat falls back to the default in
# backend/config.py). Every id below was verified against
# https://openrouter.ai/api/v1/models on 2026-08-29.
# ---------------------------------------------------------------------------

# OpenAI seat - "Systems Integrator". Flagship of the GPT-5.6 series.
# Alternatives: openai/gpt-5.6-terra (balanced), openai/gpt-5.6-luna (cheapest),
#               openai/gpt-5.5-pro (extended reasoning, much pricier).
# WARNING: do NOT downgrade to gpt-4o or gpt-5.2 - degrades analysis quality.
CHATGPT_MODEL_ID=openai/gpt-5.6-sol

# Anthropic seat - "Ethics Officer".
# Alternatives: anthropic/claude-sonnet-5 (cheaper), anthropic/claude-opus-5-fast.
CLAUDE_MODEL_ID=anthropic/claude-opus-5

# Google seat - "Systems Architect" (also chairs the council).
# Alternatives: google/gemini-3.7-flash (fast and cheap).
GEMINI_MODEL_ID=google/gemini-3.1-pro-preview

# xAI seat - "Red Team".
GROK_MODEL_ID=x-ai/grok-4.6

# Mistral seat - "Safety Engineer".
# NOTE: mistralai/mistral-large-2512 is stronger but returned HTTP 429 (no
# upstream capacity for this account) on 2026-08-29. Try it once capacity frees up.
# Alternatives: mistralai/mistral-large-2512, mistralai/mistral-small-2603.
MISTRAL_MODEL_ID=mistralai/mistral-medium-3-5

# Chairman - synthesizes the final answer (defaults to the Google seat)
# CHAIRMAN_MODEL=google/gemini-3.1-pro-preview

# Small, cheap model used only to title conversations
TITLE_MODEL=google/gemini-3.7-flash
